# nous-work (버섯) — Kanban 오케스트레이터
# 게이트웨이에서 디스패처를 돌리는 유일한 프로필.
# 모델/프로바이더는 hermes setup / 로컬 환경에 맞게 채울 것.

# toolsets:
#   - hermes-cli
#   - kanban

kanban:
  # 플릿 전체 디스패처는 여기만 true
  dispatch_in_gateway: true
  dispatch_interval_seconds: 60
  failure_limit: 2
  # 분해 시 assignee 미지정 → default(양파)로 고정
  default_assignee: default
  # 버섯이 채팅에서 알아서 쪼개면 true 유지. 수동만 쓰려면 false
  auto_decompose: true
  auto_decompose_per_tick: 3
  dispatch_stale_timeout_seconds: 14400
