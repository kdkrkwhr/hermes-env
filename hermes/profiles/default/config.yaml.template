# default (양파) — Kanban 워커
# 디스패처는 nous-work만 돌림. 이 프로필은 spawn만.
# 실제 모델/프로바이더는 hermes setup으로.

kanban:
  dispatch_in_gateway: false
  dispatch_interval_seconds: 60
  failure_limit: 2
  default_assignee: ""
  auto_decompose: true
  auto_decompose_per_tick: 1
  dispatch_stale_timeout_seconds: 14400
