# claude — Kanban 워커 (하드 코딩 전담 시)
# 디스패처는 nous-work만 돌림. 이 프로필은 spawn만.

# toolsets:
#   - hermes-cli
#   - kanban

kanban:
  dispatch_in_gateway: false
  dispatch_interval_seconds: 60
  failure_limit: 2
  default_assignee: ""
  auto_decompose: true
  auto_decompose_per_tick: 3
  dispatch_stale_timeout_seconds: 14400
