@echo off
REM [Windows] 로그온 자동복구: coral-server 기동 + 세션 재생성 + 5프로필 주입 + gateway 재시작.
REM 설치: 이 파일의 __HERMES_HOME__ 치환 후 .cmd 로 저장하여
REM   %APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\ 에 복사.
REM (관리자 권한 불필요. 스케줄 태스크로 하려면 관리자 권한 필요)
set BASH="C:\Program Files\Git\usr\bin\bash.exe"
set HH=__HERMES_HOME__
%BASH% -lc "HERMES_HOME='%HH%' bash '%HH%/coral/setup-hermes-coral.sh' --inject pm,dev,infra,qa,ops"
%BASH% -lc "HERMES_HOME='%HH%' hermes gateway restart"
